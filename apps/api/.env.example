OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_SMART=openai/gpt-4.1
MODEL_FAST=deepseek/deepseek-v4.1-flash
PROVIDER_SMART=
PROVIDER_FAST=baidu/fp8
REASONING_FAST=false
REASONING_SMART=
REASONING_NODES=prosecutor,defender
OUTPUT_MODE_FAST=prompted
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
WEB_SEARCH=on
DATABASE_URL=postgresql+asyncpg://livegraph:livegraph@localhost:5433/livegraph
CORS_ORIGINS=http://localhost:3000
LOGFIRE_TOKEN=
LOGFIRE_READ_TOKEN=
OUTPUT_MODE_AGENTS=prompted
AGENT_TOOLS=research,prosecutor,defender,judge,critic,plan
RESEARCH_SEED_K=4
SEARCH_K_MAX=8
WEB_SEARCH_MAX_PER_NODE=2
FETCH_PAGE=false
FETCH_MAX_BYTES=400000
FETCH_TIMEOUT=10
JUDGE_MAX_REBUTTALS=2
# history compaction (older long tool results -> recall(ref) stubs above this estimate) + cross-agent read tools
HISTORY_BUDGET_TOKENS=6000
HISTORY_KEEP_RECENT=2
CONTEXT_TOOLS=true
CONTEXT_TOOLS_SINGLE_SHOT=false
# request_upstream_work (judge/prosecutor/defender): agent requests per run, one per (requester, target)
MAX_UPSTREAM_REQUESTS=3
NODE_TIMEOUT_SCALE=1.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Web search: exa (direct Exa API) | openrouter (OpenRouter web plugin) | auto (exa when EXA_API_KEY is set)
WEB_PROVIDER=auto
EXA_API_KEY=
